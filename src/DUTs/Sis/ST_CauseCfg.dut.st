// Назначение: строка матрицы причин и следствий: включение причины, источник требования,
//             задержка, пусковой обход: срок и подтверждение нормы для автоснятия (раздел 6.4).
// Автор:      <ИМЯ ФАМИЛИЯ>
// Версия:     0.2.0
// Документ:   docs/DESIGN.md, раздел «4.2 Структуры»
// ВНИМАНИЕ:   код демонстрационный и не предназначен для систем безопасности. Реальная ПАЗ
//             требует определения SIL, сертифицированных аппаратных и программных средств
//             и валидации по ГОСТ Р МЭК 61511.
{attribute 'qualified_only'}
TYPE ST_CauseCfg :
STRUCT
    xEnable          : BOOL := FALSE;                          // причина используется
    eSource          : E_CauseSource := E_CauseSource.Voting;  // источник требования
    tDelay           : TIME := T#0S;                           // задержка срабатывания, <= SIS_DELAY_MAX
    xOverrideAllowed : BOOL := FALSE;                          // пусковой обход разрешён
    tOverrideMax     : TIME := T#0S;                           // длительность обхода, (0, SIS_OVERRIDE_MAX]
    tOverrideClear   : TIME := T#0S;                           // подтверждение нормы для автоснятия, (0, tOverrideMax)
END_STRUCT
END_TYPE
