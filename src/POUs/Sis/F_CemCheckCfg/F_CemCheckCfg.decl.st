// Назначение: проверка конфигурации матрицы: сумма битов CEM_CFG_* (таблица 4.3); 0 — верна.
//             При CEM_CFG_COUNT причины и следствия не проверяются, CRC проверяется всегда.
//             Используемая причина — i <= uiCauseCount (включена она или нет), используемое
//             следствие — j <= uiEffectCount.
// Автор:      <ИМЯ ФАМИЛИЯ>
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, раздел «6.8 Конфигурация и CRC»
// ВНИМАНИЕ:   код демонстрационный и не предназначен для систем безопасности. Реальная ПАЗ
//             требует определения SIL, сертифицированных аппаратных и программных средств
//             и валидации по ГОСТ Р МЭК 61511.
FUNCTION F_CemCheckCfg : WORD
VAR_IN_OUT CONSTANT
    stCfg : ST_CemCfg;   // проверяемая конфигурация
END_VAR
VAR
    wErr       : WORD;          // найденные ошибки
    wUsedMask  : WORD;          // биты используемых причин
    uiI        : UINT;          // индекс причины
    uiJ        : UINT;          // индекс следствия
    stCause    : ST_CauseCfg;   // копия строки
    stEffect   : ST_EffectCfg;  // копия столбца
    xSourceOk  : BOOL;          // источник требования из перечисления
    xOvrTimeOk : BOOL;          // длительность обхода в (0, SIS_OVERRIDE_MAX]
    xSafeOk    : BOOL;          // безопасное состояние из перечисления
    xCauseBad  : BOOL;          // есть неверная причина
    xEffectBad : BOOL;          // есть неверное следствие
END_VAR
