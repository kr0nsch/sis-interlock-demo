// Назначение: шаг CRC-16/CCITT-FALSE по одному байту: полином 16#1021, без отражения, старший
//             бит первым (раздел 6.8).
// Автор:      <ИМЯ ФАМИЛИЯ>
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, раздел «6.8 Конфигурация и CRC»
// ВНИМАНИЕ:   код демонстрационный и не предназначен для систем безопасности. Реальная ПАЗ
//             требует определения SIL, сертифицированных аппаратных и программных средств
//             и валидации по ГОСТ Р МЭК 61511.
FUNCTION F_SisCrc16Byte : WORD
VAR_INPUT
    wCrc  : WORD;    // CRC до этого байта
    bData : BYTE;    // очередной байт
END_VAR
VAR
    wReg  : WORD;    // регистр CRC
    uiBit : UINT;    // номер шага по битам
END_VAR
