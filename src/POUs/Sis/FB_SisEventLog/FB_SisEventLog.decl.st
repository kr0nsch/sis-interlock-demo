// Назначение: кольцевой журнал событий ПАЗ на SIS_LOG_SIZE записей: номер события udiSeq
//             присваивает журнал (1, 2, ...; после 16#FFFFFFFF — снова 1), самая старая запись
//             затирается. SCADA читает кольцо astRing по udiSeq и видит пропуски, если опрос
//             медленнее заполнения. Астрономическое время в ПЛК не ставится — дело приёмника.
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, раздел «7.1 FB_SisEventLog IMPLEMENTS I_SisEventSink»
// ВНИМАНИЕ:   код демонстрационный и не предназначен для систем безопасности. Реальная ПАЗ
//             требует определения SIL, сертифицированных аппаратных и программных средств
//             и валидации по ГОСТ Р МЭК 61511.
FUNCTION_BLOCK FB_SisEventLog IMPLEMENTS I_SisEventSink
VAR
    astRing : ARRAY[0..GVL_Const.SIS_LOG_SIZE - 1] OF ST_SisEvent;   // кольцо
    uiNext  : UINT;      // индекс следующей записи
    uiUsed  : UINT;      // занято, 0..SIS_LOG_SIZE
    udiSeq  : UDINT;     // номер последнего события
END_VAR
