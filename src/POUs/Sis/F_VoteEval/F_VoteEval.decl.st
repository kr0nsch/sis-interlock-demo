// Назначение: голосование MooN по состояниям каналов с деградацией по политике — прямой
//             перенос нормативного алгоритма раздела 5.2 (таблицы деградации — раздел 5.3).
//             Чистая функция: результат зависит только от входов.
// Автор:      kr0nsch
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, раздел «5.2 F_VoteEval — нормативный алгоритм»
// ВНИМАНИЕ:   код демонстрационный и не предназначен для систем безопасности. Реальная ПАЗ
//             требует определения SIL, сертифицированных аппаратных и программных средств
//             и валидации по ГОСТ Р МЭК 61511.
FUNCTION F_VoteEval : ST_VoteResult
VAR_INPUT
    eArch   : E_VoteArch;                                              // схема голосования
    ePolicy : E_DegradePolicy;                                         // политика деградации
    aeCh    : ARRAY[1..GVL_Const.SIS_VOTE_CH_MAX] OF E_ChannelState;   // состояния каналов
END_VAR
VAR
    stRes     : ST_VoteResult;   // результат
    uiK       : UINT;            // номер канала
    diN       : DINT;            // каналов в схеме, N
    diM       : DINT;            // голосов схемы, M
    diN2oo3   : DINT;            // N схемы 2oo3 — для распознавания действующей схемы
    diB       : DINT;            // каналов Bypassed
    diF       : DINT;            // каналов Invalid (и NotUsed внутри N)
    diD       : DINT;            // каналов Demand
    diH       : DINT;            // каналов Normal
    diX       : DINT;            // каналов, исключённых из голосования
    diFv      : DINT;            // недостоверных каналов, которые голосуют «на останов»
    diR       : DINT;            // каналов в голосовании
    diMeff    : DINT;            // голосов после деградации
    diMh      : DINT;            // голосов, требуемых от исправных каналов
    diRh      : DINT;            // исправных каналов в голосовании
    xPolicyOk : BOOL;            // политика из перечисления
END_VAR
