// Назначение: собрать запись ST_SisEvent и передать приёмнику журнала; itfLog = 0 — без журнала.
//             Общая точка записи событий FB_Voting и FB_CauseEffect (раздел 7.2): номер события
//             udiSeq присваивает приёмник. TRUE — событие записано.
// Автор:      <ИМЯ ФАМИЛИЯ>
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, раздел «7.2 Кто пишет события»
// ВНИМАНИЕ:   код демонстрационный и не предназначен для систем безопасности. Реальная ПАЗ
//             требует определения SIL, сертифицированных аппаратных и программных средств
//             и валидации по ГОСТ Р МЭК 61511.
FUNCTION F_SisLogEvent : BOOL
VAR_INPUT
    itfLog    : I_SisEventSink;   // приёмник; 0 — без журнала
    ltTime    : LTIME;            // отметка источника времени (ltNow вызова)
    eKind     : E_SisEventKind;   // вид события
    uiCause   : UINT;             // причина, код первопричины или 0
    uiEffect  : UINT;             // следствие или 0
    uiChannel : UINT;             // канал группы или 0
    rValue    : REAL;             // значение, разброс, код ошибки или 0.0
END_VAR
VAR
    stEvent : ST_SisEvent;        // запись
END_VAR
