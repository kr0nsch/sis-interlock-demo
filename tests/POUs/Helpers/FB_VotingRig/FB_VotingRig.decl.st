// Назначение: стенд тестов FB_Voting: подменное время (старт LTIME#1H), журнал событий и группа
//             голосования; тест пишет входы стенда и вызывает Cycle/Step/Run.
// Автор:      <ИМЯ ФАМИЛИЯ>
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, раздел «12.3 Граничные случаи (вручную, команда A)»
// ВНИМАНИЕ:   код демонстрационный и не предназначен для систем безопасности. Реальная ПАЗ
//             требует определения SIL, сертифицированных аппаратных и программных средств
//             и валидации по ГОСТ Р МЭК 61511.
FUNCTION_BLOCK FB_VotingRig
VAR_INPUT
    stIn          : ST_VoteIn;          // сигналы каналов
    stCmd         : ST_VoteCmd;         // запросы байпаса
    stCfg         : ST_VotingCfg;       // конфигурация группы
    xBypassPermit : BOOL := TRUE;       // ключ разрешения байпасов
    uiCause       : UINT := 7;          // номер причины в событиях
END_VAR
VAR
    fbTime : PL.FB_FakeTime;            // подменное время
    fbLog  : FB_SisTestLog;             // журнал событий
    fbVote : FB_Voting;                 // ФБ под тестом
END_VAR
