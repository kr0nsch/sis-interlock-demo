// «Время назад» во время подтверждения нормы (D-19, 6.4): обход причины 2, требование ушло в t2, до
// автоснятия осталось 10 с; источник времени пошёл назад — TimeFault, обход снят как недостоверный по
// сроку (OverrideExpired, не OverrideCleared), подтверждение сброшено, фиксации нет (требования нет);
// позже OverrideCleared не появляется, а новое требование фиксируется через задержку 5 с
METHOD PRIVATE TimeBackwardsDuringConfirmEndsOverride
VAR
    fbRig : FB_CemRig;   // стенд
    ltT2  : LTIME;       // момент, когда требование ушло
END_VAR
