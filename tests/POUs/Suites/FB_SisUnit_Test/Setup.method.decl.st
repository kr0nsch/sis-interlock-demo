// Стенд узла: 3 причины, 2 следствия, без срабатывания при старте.
//   1 — голосование DI 1oo2 (VoteTrip, байпас до 10 с), задержка 2 с;
//   2 — внешняя (xExtDemand), без задержки;
//   3 — выключена (группа DI 1oo1 задана).
//   Следствие 1 — причина 1 (16#0001); 2 — причины 2, 3 (16#0006). Каналы групп 1 и 3 — в норме.
METHOD Setup
VAR_IN_OUT
    fbRig : FB_UnitRig;    // стенд
END_VAR
VAR
    stCem  : ST_CemCfg;    // матрица
    stVote : ST_VotingCfg; // группа голосования
    uiK    : UINT;         // номер канала
END_VAR
