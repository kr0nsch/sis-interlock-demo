coUnit.TEST('Voting_Bypass_EventsWithChannel');
fbRig.stCfg := CfgDi(eArch := E_VoteArch.Vote2oo3, ePolicy := E_DegradePolicy.VoteTrip);
fbRig.SetDi(x1 := TRUE, x2 := TRUE, x3 := TRUE);
fbRig.uiCause := 12;
fbRig.stCmd.axBypassReq[2] := TRUE;
fbRig.Step(tStep := T#250MS);
ltOn := fbRig.Now();
stEv := fbRig.fbLog.GetEvent(uiBack := 0);
AssertEquals_INT(Expected := TO_INT(E_SisEventKind.BypassOn), Actual := TO_INT(stEv.eKind), Message := 'BypassOn');
AssertEquals_UINT(Expected := 2, Actual := stEv.uiChannel, Message := 'BypassOn: channel 2');
AssertEquals_UINT(Expected := 12, Actual := stEv.uiCause, Message := 'BypassOn: cause 12');
AssertEquals_UINT(Expected := 0, Actual := stEv.uiEffect, Message := 'BypassOn: no effect');
AssertEquals_LTIME(Expected := ltOn, Actual := stEv.ltTime, Message := 'BypassOn: time of the call');
fbRig.stCmd.axBypassReq[2] := FALSE;
fbRig.Step(tStep := T#1S);
stEv := fbRig.fbLog.GetEvent(uiBack := 0);
AssertEquals_INT(Expected := TO_INT(E_SisEventKind.BypassOff), Actual := TO_INT(stEv.eKind), Message := 'BypassOff');
AssertEquals_UINT(Expected := 2, Actual := stEv.uiChannel, Message := 'BypassOff: channel 2');
AssertEquals_LTIME(Expected := ltOn + LTIME#1S, Actual := stEv.ltTime, Message := 'BypassOff: time of the call');
coUnit.TEST_FINISHED();
