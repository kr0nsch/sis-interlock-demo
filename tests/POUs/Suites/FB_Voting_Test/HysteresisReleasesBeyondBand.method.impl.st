coUnit.TEST('Voting_Hysteresis_ReleasesBeyondBand');
fbRig.stCfg := CfgAi(eArch := E_VoteArch.Vote1oo1, ePolicy := E_DegradePolicy.VoteTrip);
fbRig.SetAi(r1 := 49.0, r2 := 0.0, r3 := 0.0);
fbRig.Cycle();
AssertFalse(Condition := fbRig.fbVote.xTrip, Message := '49.0 rising: no demand');
fbRig.SetAi(r1 := 50.0, r2 := 0.0, r3 := 0.0);
fbRig.Cycle();
AssertTrue(Condition := fbRig.fbVote.xTrip, Message := '50.0: demand');
fbRig.SetAi(r1 := 48.5, r2 := 0.0, r3 := 0.0);
fbRig.Cycle();
AssertTrue(Condition := fbRig.fbVote.xTrip, Message := '48.5 inside band: demand held');
fbRig.SetAi(r1 := 48.0, r2 := 0.0, r3 := 0.0);
fbRig.Cycle();
AssertTrue(Condition := fbRig.fbVote.xTrip, Message := '48.0 = limit - hyst: demand held');
fbRig.SetAi(r1 := 47.99, r2 := 0.0, r3 := 0.0);
fbRig.Cycle();
AssertFalse(Condition := fbRig.fbVote.xTrip, Message := '47.99 beyond band: released');
fbRig.SetAi(r1 := 49.0, r2 := 0.0, r3 := 0.0);
fbRig.Cycle();
AssertFalse(Condition := fbRig.fbVote.xTrip, Message := '49.0 after release: no demand');
coUnit.TEST_FINISHED();
