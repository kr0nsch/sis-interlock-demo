// Назначение: значение вне строгого перечисления для тестов проверки конфигурации. Строгое
//             перечисление не даёт присвоить число в исходном тексте, а в памяти оно может быть любым:
//             тест пишет iValue и читает поле перечисления. Только для тестов.
// Автор:      <ИМЯ ФАМИЛИЯ>
// Версия:     0.1.0
// Документ:   docs/DESIGN.md, раздел «12.3 Граничные случаи (вручную, команда A)»
// ВНИМАНИЕ:   код демонстрационный и не предназначен для систем безопасности. Реальная ПАЗ
//             требует определения SIL, сертифицированных аппаратных и программных средств
//             и валидации по ГОСТ Р МЭК 61511.
{attribute 'qualified_only'}
TYPE U_SisEnumInt :
UNION
    iValue     : INT;                // число, которое пишет тест
    eArch      : E_VoteArch;         // то же как схема голосования
    ePolicy    : E_DegradePolicy;    // как политика деградации
    eInput     : E_SisInputKind;     // как вид входов
    eLimitDir  : E_LimitDir;         // как направление уставки
    eChState   : E_ChannelState;     // как состояние канала
    eSource    : E_CauseSource;      // как источник требования причины
    eSafeState : E_SafeState;        // как безопасное состояние следствия
END_UNION
END_TYPE
