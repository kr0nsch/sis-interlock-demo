// Назначение: демо-сценарий срабатывания ПАЗ сепаратора V-101 в реальном времени задачи (20 мс)
//             для графика в README: старт ПЛК в сработавшем состоянии и сброс, обрыв линии
//             PT101C (2oo3 → 1oo2), рост давления до PSHH101, останов с первопричиной, падение
//             давления после закрытия ESDV101 до PSLL101 (вторичная причина), сброс при
//             действующей причине отклонён. Входы задаёт простая модель давления вместо
//             ввода-вывода; логику ПАЗ выполняет неизменённая PRG_Sis. Каждые 100 мс — отсчёт
//             в GVL_TripTrace. Задача демо-проекта вызывает эту программу вместо PRG_Main.
// Автор:      <ИМЯ ФАМИЛИЯ>
// Версия:     0.1.0
// Документ:   tools_project/demo/README.md; docs/DESIGN.md, раздел «8.4 PRG_Main»
// ВНИМАНИЕ:   код демонстрационный и не предназначен для систем безопасности. Реальная ПАЗ
//             требует определения SIL, сертифицированных аппаратных и программных средств
//             и валидации по ГОСТ Р МЭК 61511.
PROGRAM PRG_TripDemo
VAR CONSTANT
    // сценарий, секунды от первого цикла
    T_RESET_1_S      : LREAL := 2.0;        // сброс после старта ПЛК (причин нет — разрешён)
    T_WIRE_BREAK_S   : LREAL := 6.0;        // обрыв линии PT101C
    T_RISE_S         : LREAL := 10.0;       // начало роста давления
    T_RESET_2_S      : LREAL := 40.0;       // сброс при действующей PSLL101 — отклоняется
    T_PULSE_S        : LREAL := 0.5;        // длительность нажатия HS120
    T_END_S          : LREAL := 46.0;       // конец записи
    T_SAMPLE_S       : LREAL := 0.1;        // шаг записи
    // модель давления в V-101 (вымышленная динамика, только для демонстрации логики)
    P_NORMAL_MPA     : LREAL := 0.60;       // рабочее давление
    P_RISE_MPA_S     : LREAL := 0.04;       // скорость роста при открытом ESDV101
    P_MAX_MPA        : LREAL := 1.00;       // предел роста
    P_SINK_MPA       : LREAL := 0.05;       // к нему стремится давление при закрытом ESDV101
    TAU_DECAY_S      : LREAL := 5.0;        // постоянная времени падения давления
    OFFSET_B_MPA     : LREAL := -0.012;     // смещение показаний PT101B относительно PT101A
    OFFSET_C_MPA     : LREAL := 0.008;      // смещение показаний PT101C до обрыва
    // сигнал 4–20 мА
    MA_ZERO          : LREAL := 4.0;        // ток нижней границы шкалы
    MA_SPAN          : LREAL := 16.0;       // диапазон тока
    MA_WIRE_BREAK    : REAL := 2.0;         // ток при обрыве линии: ниже 3,6 мА (NE 43)
    NS_PER_S         : LREAL := 1.0E9;      // наносекунд в секунде (LTIME)
END_VAR
VAR
    xInit            : BOOL := TRUE;        // первый цикл
    ltStart          : LTIME;               // отметка первого цикла
    ltPrev           : LTIME;               // отметка прошлого цикла
    ltNow            : LTIME;               // отметка этого цикла
    lrT_s            : LREAL;               // время сценария, с
    lrDt_s           : LREAL;               // шаг модели, с
    lrNextSample_s   : LREAL;               // время следующего отсчёта, с
    lrP_MPa          : LREAL;               // давление в V-101 по модели (у PT101A)
    lrPB_MPa         : LREAL;               // показание PT101B
    lrPC_MPa         : LREAL;               // показание PT101C до обрыва
    lrSpan_MPa       : LREAL;               // шкала PT101A/B/C
    uiIdx            : UINT;                // индекс отсчёта
    wOut             : WORD;                // выходы xQ* как биты
END_VAR
